{
  "name": "tapp-capacitor-sdk",
  "version": "0.1.0-alpha.2",
  "description": "Capacitor plugin for the Tapp deep linking and attribution SDK",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "TappCapacitorSdk.podspec"
  ],
  "author": "Tapp.so",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapp-so/Tapp-Capacitor.git"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "deep linking",
    "attribution",
    "tapp"
  ],
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "lint": "eslint src && prettier --check \"src/**/*.ts\"",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:ios": "xcodebuild -scheme TappCapacitorSdk -destination generic/platform=iOS",
    "verify": "npm run verify:ios && npm run verify:android && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0 <9.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/docgen": "^0.3.0",
    "rollup": "^4.0.0",
    "typescript": "~5.9.3",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "rimraf": "^6.1.4"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "publishConfig": {
    "tag": "alpha",
    "provenance": true,
    "access": "public"
  }
}
